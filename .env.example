# ==============================================================================
# Government Document Evidence Intelligence & Briefing Management System
# Configuration Template - Do NOT commit production secrets to version control
# ==============================================================================

# Application & Environment
APP_NAME="Government Document Evidence Intelligence & Briefing Management System"
APP_ENV=development
APP_DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database - MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=gov_evidence_ledger

# Message Broker - RabbitMQ & Celery
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=rpc://
# Set to true for local development / testing without live RabbitMQ
USE_LOCAL_TASK_RUNNER=true

# Object Storage - S3 / MinIO
STORAGE_PROVIDER=local
# Options: local, minio, s3
LOCAL_STORAGE_PATH=./storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_ORIGINALS=gov-originals
MINIO_BUCKET_INTERMEDIATE=gov-intermediate
MINIO_SECURE=false

# Vector Database - Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=evidence_embeddings
QDRANT_EMBEDDING_DIM=384
# When true, falls back to in-memory/disk vector index if Qdrant daemon is offline
QDRANT_FALLBACK_LOCAL=true

# AI & Processing Pipelines
# OCR Engine configuration (Tesseract)
TESSERACT_CMD=tesseract
TESSERACT_LANGUAGES=eng+hin+guj
OCR_CONFIDENCE_THRESHOLD=60.0

# Language Detection & Translation
INDICTRANS2_ENABLED=false
INDICTRANS2_MODEL_PATH=/models/indictrans2
INDICTRANS2_DEVICE=cpu
# English bypass is always active per authoritative architecture

# Named Entity Recognition (NER)
NER_PROVIDER=rule_and_regex
# Options: rule_and_regex, spacy, transformers, ollama
NER_CONFIDENCE_THRESHOLD=0.75

# LLM Extraction & Structured Analysis
LLM_PROVIDER=ollama
# Options: ollama, openai_compatible, mock, rule_based
LLM_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=llama3
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60

# Embeddings
EMBEDDING_PROVIDER=sentence_transformers
# Options: sentence_transformers, local_tfidf, mock
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Initial Admin Bootstrap (Used only during initial seeding)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@gov.internal
BOOTSTRAP_ADMIN_PASSWORD=AdminSecureGov2026!
BOOTSTRAP_ADMIN_FULLNAME="Senior System Administrator"
